# Copy this file to .env and fill in your keys.
# .env is git-ignored and must never be committed.

YOUTUBE_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here

# Git-synced registry database (src/registry/db.py). The registry
# (channels, videos, song groupings, view snapshots) is stored as SQL text
# in a private git repo rather than a local file or a hosted database -
# every machine clones/pulls the same authoritative copy and rebuilds its
# own local working copy from it. See README's "Git-synced registry
# database" section for one-time setup.
REGISTRY_DATA_REPO_URL=git@github.com:your-org/your-registry-data-repo.git

# Optional spend safeguards (src/shared/api_budget.py) - sync/catalog/chart
# commands stop cleanly before exceeding these rather than letting a real API
# error happen mid-run. Set them here; api_budget.py only reads these env vars.
#
# YOUTUBE_DAILY_QUOTA matches YouTube's standard free-tier daily quota. That
# allocation is fixed - raising it goes through a quota extension request, not
# billing - so there is usually no reason to change this.
#
# GEMINI_DAILY_LIMIT is a spend guard rather than a tier's rate limit. Gemini
# bills per token, so the request count isn't the cost directly, but capping
# requests bounds a runaway loop. 100 sits under a typical free-tier Flash RPD
# (check yours in AI Studio; raise if yours is higher). Regroup does not spend
# this budget - it uses free tiers then the CLI agent.
# YOUTUBE_DAILY_QUOTA=10000
GEMINI_DAILY_LIMIT=100

# yt-dlp bot-check fallback (src/shared/ytdlp_throttle.py). Reading cookies
# straight out of a running browser's profile can fail (locked DB, or
# App-Bound Encryption on recent Chrome/Edge - DPAPI can't decrypt those
# cookies from another process). Exporting a cookies.txt once via a browser
# extension (e.g. "Get cookies.txt LOCALLY") and pointing this at it sidesteps
# both problems. Never commit this file - it carries a live YouTube session.
# YTDLP_COOKIES_FILE=cookies.txt
# YTDLP_COOKIES_BROWSER=edge

# bgutil PO Token HTTP server (required for the mweb high-res fallback
# client). Default matches the plugin's own default. Override only if you
# published the server on a different host/port.
# YTDLP_POT_BASE_URL=http://127.0.0.1:4416

# Soft ceiling (seconds) on a single yt-dlp download attempt before the
# fallback ladder moves on. A hung client negotiation otherwise can pin a
# download worker for minutes.
# YTDLP_DOWNLOAD_ATTEMPT_TIMEOUT=60

# Minimum raw-clip video height. Below this, the pipeline re-fetches the
# same section via quality-preserving clients (never android/360p) and
# keeps the taller file if one lands. The style canvas height also raises
# this floor (a 1440p canvas won't settle for shorter sources). Default
# 1440 matches assets/templates/style.json.
# YTDLP_MIN_RAW_HEIGHT=1440
