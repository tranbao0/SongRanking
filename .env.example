# Copy this file to .env and fill in your keys.
# .env is git-ignored and must never be committed.

YOUTUBE_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here

# Optional spend safeguards (src/api_budget.py) — sync/catalog/chart commands
# stop cleanly before exceeding these rather than letting a real API error
# happen mid-run. Defaults match YouTube's standard free-tier daily quota.
# GEMINI_DAILY_LIMIT's default is a conservative placeholder, not a published
# guarantee — set it to your actual Gemini tier's daily request limit if you
# know it (free-tier limits vary by model/tier and change over time).
# YOUTUBE_DAILY_QUOTA=10000
# GEMINI_DAILY_LIMIT=1500
